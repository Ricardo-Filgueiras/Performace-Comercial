	measure '11 Qtde Vendas' = DISTINCTCOUNT(fVendas[Num Venda])
		formatString: #,0
		displayFolder: 01.Principais
		lineageTag: c6e2dfed-b1f9-4897-983b-d5594124b063

		changedProperty = FormatString

	/// Quantidade de clientes únicos com vendas efetivadas (Status = 1)
	measure '12 Positivação Clientes' =
			
			// Refere-se a Qtde de clientes que efetuaram compras efetivadas
			CALCULATE(
			    DISTINCTCOUNT(fVendas[Id Cliente]),
			    dStatus[Id Status] = 1
			)
		formatString: 0
		displayFolder: 01.Principais
		lineageTag: a8cec11c-cf82-487e-b973-012198c81a2d

	/// Quantidade de produtos únicos vendidos (Status = 1)
	measure '13 Positivação Produtos' =
			
			// Refere-se a Qtde de produtos vendidos efetivamente
			CALCULATE(
			    DISTINCTCOUNT(fVendas[Id Produto]),
			    dStatus[Id Status] = 1
			)
		formatString: 0
		displayFolder: 01.Principais
		lineageTag: c2012781-389d-45e0-893e-ae783dfc4007

	measure '01 Faturamento' = ```
			
			    CALCULATE(
			        SUMX(
			            fVendas,
			            fVendas[Qtde] * fVendas[Valor Unit]
			        ),
			        dStatus[Id Status] = 1
			    )
