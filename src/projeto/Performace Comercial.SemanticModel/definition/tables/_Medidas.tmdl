	/// Margem Bruta (%) = (Faturamento - Custo) / Faturamento
	measure '04 Margem Bruta' =
			
			// Margem Bruta = (Faturamento - Custo) / Faturamento
			VAR _Faturamento = [01 Faturamento]
			VAR _Custo = [02 Custo]
			VAR _MargemBruta = _Faturamento - _Custo
			
			RETURN
			    DIVIDE(
			        _MargemBruta,
			        _Faturamento,
			        BLANK()
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01.Principais
		lineageTag: 30b91ae6-c3b0-44f0-9294-73a4725abaf9

